---
import type { FeatureData } from '../types'
import { Image } from 'astro:assets'
import FlagImg from '../assets/flag.png'
import { formatUsage } from '../utils/format-usage'

interface Props {
  data: FeatureData
  source: string
}

const data = Astro.props.data
const usage = data.usage
const usageLabel = usage
  ? [
      `Globals: ${formatUsage(usage.total)} of all users can use this feature`,
      `${formatUsage(usage.supported)} fully supported`,
      `${formatUsage(usage.partial)} partially supported`,
    ].join(', ')
  : ''
---

{usage && (
  <small class="note" aria-label={usageLabel}>
    <span aria-hidden="true">
      Globals:{' '}
      {usage.supported && <span class="y">{formatUsage(usage.supported)}</span>}
      {usage.supported && usage.partial ? ' + ' : ''}
      {usage.partial ? <span class="a">{formatUsage(usage.partial)}</span> : ''}
      {usage.total && usage.partial ? ` = ${formatUsage(usage.total)}` : ''}
    </span>
  </small>
)}

<div class="legend" aria-label="Legend">
  <div class="y" title="Support">&#x2713;<span class="sr-only">Supported</span></div>
  <div class="n" title="Not Support">&#x2717;<span class="sr-only">Not supported</span></div>
  {data.unknown && (<div class="u" title="Unknown Support">?<span class="sr-only">Unknown support</span></div>)}
  <div class="a">Partial support</div>
  {data.prefixed && <div class="x">Prefixed</div>}
  {data.flag && (
    <div class="d" id="legendD">
      <Image src={FlagImg} alt="" aria-hidden="true" />
      Behind a Flag
    </div>
  )}
</div>
